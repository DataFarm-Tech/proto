GpsUpdateRequest.node_id      max_size:32
GpsUpdateRequest.hw_ver       max_size:32
GpsUpdateRequest.chassis_ver  max_size:32

OtaStatus.fw_ver  max_size:32

NetInfo.iccid  max_size:24
NetInfo.imei   max_size:16
NetInfo.imsi   max_size:16

NetStat.carrier   max_size:32
NetStat.cell_id   max_size:8

ReadingRequest.node_id   max_size:32
ReadingRequest.m_type    max_size:16

# 512 rather than a round 256: this carries B2 signed download-authorization
# URLs (base URL + "?Authorization=" + URL-encoded token), which can land
# close to or over 256 bytes on their own. nanopb decode fails outright
# (doesn't truncate) if a message doesn't fit this buffer.
StringValue.value  max_size:512

HealthRequest.node_id     max_size:32
HealthRequest.boot_reason max_size:32
HealthRequest.fw_ver      max_size:32

ConfigRequest.node_id max_size:32

# Matches GpsUpdateRequest.hw_ver's own sizing above.
FirmwareVersionRequest.hw_ver max_size:32

# Matches wifi_config_t.sta.ssid/password (ESP-IDF's own limits: 32 bytes
# for an SSID, 64 for a WPA2-PSK passphrase), plus a null terminator.
ConfigResponse.wifi_ssid     max_size:33
ConfigResponse.wifi_password max_size:65
# Covers "0x" + a wide multi-band hex mask + null terminator with headroom.
ConfigResponse.lte_bandmask  max_size:40

LogChunk.node_id max_size:32
# Send-side chunk size is 512 bytes of raw log text; this leaves headroom
# for nanopb's own length-prefix bookkeeping without needing to match exactly.
LogChunk.data     max_size:600

WalkTestPoint.node_id max_size:32

ReadingBatchRequest.node_id max_size:32
# NPK::NUM_MEASUREMENTS is 7 (N/P/K/moisture/pH/temp/conductivity) -- 8
# leaves headroom for one more type without needing to touch this again.
ReadingBatchRequest.readings max_count:8
ReadingEntry.m_type max_size:16
